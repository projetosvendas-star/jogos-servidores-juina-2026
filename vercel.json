{
  "version": 2,
  "buildCommand": "corepack enable && corepack prepare pnpm@10.4.1 --activate && pnpm install && pnpm run build",
  "installCommand": "echo skip",
  "builds": [
    { "src": "dist/api/index.mjs", "use": "@vercel/node" },
    { "src": "dist/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/dist/api/index.mjs" },
    { "src": "/manus-storage/(.*)", "dest": "/dist/api/index.mjs" },
    { "src": "/assets/(.*)", "dest": "/dist/public/assets/$1" },
    { "src": "/(.*)\\.(png|jpg|jpeg|gif|svg|webp|ico|css|js|json|txt)$", "dest": "/dist/public/$1.$2" },
    { "src": "/(.*)", "dest": "/dist/public/index.html" }
  ]
}
